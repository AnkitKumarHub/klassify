# Server
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/klassify

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

# Seeding (optional) — passwords for the seeded accounts. SEED_PASSWORD covers
# the user accounts; SEED_ADMIN_PASSWORD covers the admin and falls back to
# SEED_PASSWORD when unset. Minimum 8 characters. If neither is set,
# `pnpm db:seed` generates a random password and prints it once.
SEED_PASSWORD=
SEED_ADMIN_PASSWORD=
